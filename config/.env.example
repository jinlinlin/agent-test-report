# 复制为 .env 并填入真实值；.env 不要提交到仓库
OPENAI_API_KEY=sk-your-key-here

# 禅道服务地址（内网真实地址放这里，勿写进 settings.yaml）
ZENTAO_BASE_URL=http://your-intranet-host/zentao

# 禅道接入（二选一）：
# 方式一：账号密码换 token（禅道 RESTful API 标准做法，推荐）
ZENTAO_ACCOUNT=your-readonly-account
ZENTAO_PASSWORD=your-password
# 方式二：直接使用预置的长期只读 token（若填了 ZENTAO_TOKEN 则优先使用它）
ZENTAO_TOKEN=

# 注意（F7 只读原则）：以上账号/Token 必须具备只读权限，不得拥有新增/修改/关闭缺陷的能力

# 飞书自建应用（V2 技术验证：报告推送至飞书云文档/知识库）
FEISHU_APP_ID=cli_your-app-id
FEISHU_APP_SECRET=your-app-secret
FEISHU_DOC_BASE_URL=https://my.feishu.cn   # 个人版；企业租户改为 https://你的域名.feishu.cn
FEISHU_FOLDER_TOKEN=                        # 导入上传落点（云空间文件夹 folder_token）
FEISHU_WIKI_SPACE_ID=                       # 知识库 space_id（用 scripts/feishu_wiki_probe.py 获取）
FEISHU_WIKI_PARENT_NODE=                    # 项目锚点节点 node_token（如 Uniresearch项目测试）
