        "version_name": "UniResearch V5.0.0",
        "total": 24,
        "closed": 15,
        "pending_resolve": 4,
        "pending_accept": 3,
        "postponed": 2,
        "fix_coverage": "62.50%",
        "p1_pass": true,
        "p2_pass": false,
        "p3_pass": true,
        "advice_contains": "P2 激活占比"
      }
    },
    {
      "id": "V6.0.0-全关闭达标可发布",
