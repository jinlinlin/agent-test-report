      "fault": "none",
      "expect": {
        "status": "finished",
        "version_name": "UniResearch V6.0.0",
        "total": 5,
        "closed": 5,
        "pending_resolve": 0,
        "pending_accept": 0,
        "postponed": 0,
        "fix_coverage": "100.00%",
        "p1_pass": true,
        "p2_pass": true,
        "p3_pass": true,
        "advice_contains": "各项准入指标均达标"
      }
    },
    {
      "id": "V6.1.0-激活P1直接否决",
