#!/bin/sh
# post-commit —— 每次 git commit 后自动生成一份「修复记录」并追加一个 docs: 修复记录 提交。
#
# 源文件受版本控制：scripts/git-hooks/post-commit
# 新克隆 / 换机器后启用：powershell -ExecutionPolicy Bypass -File scripts/install-hooks.ps1
# 临时关闭：删除 .git/hooks/post-commit 即可（不影响正常提交）。
#
# 设计要点：
# 1) 递归保护：自动生成的那笔「docs: 修复记录」提交会再次触发本钩子，靠标题前缀识别后直接退出，避免死循环。
# 2) 只纳入本次记录文件（pathspec 提交），不会裹挟工作区里其它已暂存改动。
# 3) 任何步骤失败都静默 exit 0，绝不阻断用户的正常提交。

repo_root=$(git rev-parse --show-toplevel) || exit 0
cd "$repo_root" || exit 0

# 1) 递归保护
subject=$(git log -1 --pretty=%s)
case "$subject" in
  "docs: 修复记录 "*) exit 0 ;;
esac

# 2) 读取本次提交元数据
short=$(git rev-parse --short HEAD)
full=$(git rev-parse HEAD)
adate=$(git log -1 --date=format:%Y-%m-%d\ %H:%M:%S --pretty=%ad)
author=$(git log -1 --pretty='%an <%ae>')
body=$(git log -1 --pretty=%b)
fname_ts=$(git log -1 --date=format:%Y%m%d-%H%M%S --pretty=%ad)

rec_dir="docs/修复记录"
mkdir -p "$rec_dir"
rec_path="$rec_dir/${fname_ts}-${short}.md"

namestatus=$(git show --pretty=format: --name-status HEAD)
stat=$(git diff-tree --no-commit-id --stat -r HEAD)

# 3) 写记录文件
{
  printf '# 修复记录 %s\n\n' "$short"
  printf '%s\n' "- 提交号：$full"
  printf '%s\n' "- 提交时间：$adate"
  printf '%s\n' "- 作者：$author"
  printf '%s\n' "- 标题：$subject"
  printf '\n'
  printf '## 说明\n\n'
  if [ -n "$body" ]; then
    printf '%s\n\n' "$body"
  else
    printf '%s\n\n' "（本次提交无附加说明）"
  fi
  printf '## 变更文件\n\n'
  printf '```\n%s\n```\n\n' "$namestatus"
  printf '## 变更统计\n\n'
  printf '```\n%s\n```\n' "$stat"
} > "$rec_path"

# 4) 追加提交（仅纳入本次记录文件）
git add -- "$rec_path" || exit 0
git commit -q -m "docs: 修复记录 ${short} ${subject}" -- "$rec_path" || exit 0

exit 0
